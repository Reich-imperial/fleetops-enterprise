# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
*.tfplan
tfplan
plan.txt
# Keep the lock file — it pins provider versions for reproducible builds
!.terraform.lock.hcl

# Generated by `terraform plan -generate-config-out`
generated.tf

# OS / editor
.DS_Store
*.swp
.vscode/
.idea/

# Lambda build artifacts (Phase 10)
lambda/**/node_modules/
lambda/**/*.zip
lambda/**/__pycache__/

# Secrets — never commit these
*.pem
*.key
.env
.env.*
